{
  "rules": {
    ".read": false,
    ".write": false,
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "staffUsers": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "deutschA1": {
      "admins": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          ".write": false
        }
      },
      "users": {
        ".read": "auth != null && root.child('deutschA1').child('admins').child(auth.uid).val() === true",
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || root.child('deutschA1').child('admins').child(auth.uid).val() === true)",
          ".write": "auth != null && root.child('deutschA1').child('admins').child(auth.uid).val() === true"
        }
      },
      "results": {
        ".read": "auth != null && root.child('deutschA1').child('admins').child(auth.uid).val() === true",
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || root.child('deutschA1').child('admins').child(auth.uid).val() === true)",
          ".write": "auth != null && (auth.uid === $uid || root.child('deutschA1').child('admins').child(auth.uid).val() === true)"
        }
      },
      "activity": {
        ".read": "auth != null && root.child('deutschA1').child('admins').child(auth.uid).val() === true",
        "$uid": {
          ".read": "auth != null && (auth.uid === $uid || root.child('deutschA1').child('admins').child(auth.uid).val() === true)",
          ".write": "auth != null && auth.uid === $uid"
        }
      },
      "groups": {
        ".read": "auth != null",
        "$groupId": {
          ".write": "auth != null && root.child('deutschA1').child('admins').child(auth.uid).val() === true"
        }
      },
      "vocabularyTests": {
        ".read": "auth != null && root.child('deutschA1').child('admins').child(auth.uid).val() === true",
        ".write": "auth != null && root.child('deutschA1').child('admins').child(auth.uid).val() === true"
      },
      "vocabularyTestContent": {
        ".read": "auth != null && root.child('deutschA1').child('admins').child(auth.uid).val() === true",
        ".write": "auth != null && root.child('deutschA1').child('admins').child(auth.uid).val() === true"
      }
    }
  }
}
